{
  "build": {
    "beforeDevCommand": "dx serve --platform web",
    "beforeBuildCommand": "dx bundle --platform web --release",
    "devPath": "http://localhost:8080",
    "distDir": "../dist/web"
  },
  "package": {
    "productName": "Jabu",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeFile": true,
        "removeDir": true,
        "renameFile": true,
        "exists": true
      },
      "path": {
        "all": false
      },
      "protocol": {
        "all": false,
        "asset": true,
        "assetScope": ["**"]
      },
      "http": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "clipboard": {
        "all": true,
        "readText": true,
        "writeText": true,
        "writeImage": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "globalShortcut": {
        "all": true
      },
      "window": {
        "all": true,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true,
        "setTitle": true,
        "setFullscreen": true,
        "setResizable": true,
        "setDecorations": true,
        "setAlwaysOnTop": true,
        "setContentProtected": true,
        "setSize": true,
        "setMinSize": true,
        "setMaxSize": true,
        "setPosition": true,
        "center": true,
        "requestUserAttention": true,
        "setIcon": true,
        "setSkipTaskbar": true,
        "setProgressBar": true,
        "setBadgeLabel": true,
        "setCursorIcon": true,
        "setCursorGrab": true,
        "setCursorVisible": true,
        "setIgnoreCursorEvents": true,
        "setContentProtection": true,
        "setBackgroundColor": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "assets/icons/icon.png",
        "assets/icons/icon.icns",
        "assets/icons/icon.ico"
      ],
      "resources": ["assets/**/*"],
      "copyright": "2024 Jabu Contributors",
      "category": "Social Networking",
      "shortDescription": "Cross-platform XMPP client",
      "longDescription": "A modern, cross-platform XMPP client built with Rust and Dioxus",
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-common"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "librsvg2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "dmg": {
        "windowSize": [800, 600]
      },
      "macos": {
        "frameworks": [],
        "minimumSystemVersion": "10.15",
        "exceptionDomain": ""
      },
      "windows": {
        "webviewInstallMode": "embedBootstrapper",
        "allowDowngrades": false
      },
      "android": {
        "minSdkVersion": 24,
        "targetSdkVersion": 34
      },
      "ios": {
        "minimumSystemVersion": "15.0"
      }
    },
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:;",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Jabu",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark"
      }
    ]
  }
}