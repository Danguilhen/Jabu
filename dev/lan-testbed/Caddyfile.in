{
    admin off
    email admin@@DOMAIN@
}

@DOMAIN@ {
    encode zstd gzip

    @upload path /file_share*
    handle @upload {
        reverse_proxy 127.0.0.1:5280
    }

    @galene path /ws
    handle @galene {
        reverse_proxy 127.0.0.1:18444 {
            header_up Origin https://@DOMAIN@
        }
    }

    @galene_status path /group*
    handle @galene_status {
        reverse_proxy 127.0.0.1:18444
    }

    # Weft shares this origin. Keep /healthz on the Host.
    @weft path /.well-known/weft-client /api/v1/* /media/* /metrics /readyz /api/openapi.json
    handle @weft {
        reverse_proxy 127.0.0.1:@WEFT_PORT@
    }

    handle {
        reverse_proxy 127.0.0.1:8088
    }
}
