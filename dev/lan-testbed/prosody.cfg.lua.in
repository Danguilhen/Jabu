-- Disposable public testbed for organic.ddnsfree.com.
-- Generated by dev/lan-testbed/run.sh; do not edit the copy in state/.

local base = "@STATE@/prosody"

admins = { "admin@@DOMAIN@" }
data_path = base .. "/data"
pidfile = base .. "/prosody.pid"

modules_enabled = {
    "roster",
    "saslauth",
    "tls",
    "ping",
    "pep",
    "disco",
    "version",
    "uptime",
    "time",
    "mam",
    "carbons",
    "csi_simple",
    "smacks",
    "blocklist",
    "private",
    "vcard",
    "lastactivity",
    "http_file_share",
    "bookmarks",
    "admin_adhoc",
    "announce",
}

authentication = "internal_hashed"
allow_registration = false
allow_unencrypted_plain_auth = false
c2s_require_encryption = true

c2s_ports = { 5222 }
c2s_direct_tls_ports = { 5223 }
c2s_interface = "0.0.0.0"
s2s_ports = {}
s2s_direct_tls_ports = {}
certificates = "@STATE@/tls"

http_ports = { 5280 }
http_interfaces = { "127.0.0.1" }
https_ports = {}
http_external_url = "https://@DOMAIN@"
http_paths = { file_share = "/file_share" }

http_file_share_size_limit = 104857600
http_file_share_expires_after = "1 week"
archive_expires_after = "1y"
max_archive_query_results = 1000

ssl = {
    key = "@STATE@/tls/privkey.pem";
    certificate = "@STATE@/tls/fullchain.pem";
}

log = {
    { levels = { min = "info" }, to = "file", filename = "@STATE@/logs/prosody.log" },
}

VirtualHost "@DOMAIN@"
    enabled = true
    modules_enabled = {
        "mam",
        "carbons",
        "csi_simple",
        "smacks",
        "http_file_share",
        "bookmarks",
            "pep",
        "blocklist",
        "lastactivity",
    }

Component "conference.@DOMAIN@" "muc"
    name = "Chatrooms"
    restrict_room_creation = false
    muc_room_locking = false
    muc_room_default_public_jids = true
    modules_enabled = { "muc_mam" }

Component "pubsub.@DOMAIN@" "pubsub"
    autocreate_on_publish = true
