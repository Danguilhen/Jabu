# Direnv configuration for Jabu
# Install direnv: https://direnv.net/
# Then run: direnv allow

use flake

# Or use the shell.nix directly if not using flakes:
# use nix

# Environment variables
export RUST_BACKTRACE=1
export RUST_LOG=debug
export CARGO_HOME="$HOME/.cargo"

# Dioxus
export DX_BINARY_PATH="$CARGO_HOME/bin/dx"

# Path additions
PATH_add "$CARGO_HOME/bin"

# Project-specific aliases
alias dxw='dx serve --platform web'
alias dxd='dx serve --platform desktop'
alias dxbw='dx bundle --platform web --release'
alias dxbd='dx bundle --platform desktop --release'
alias dxt='cargo test --workspace'
alias ck='cargo check --workspace'
alias fmt='cargo fmt --all'
alias clippy='cargo clippy --workspace --all-targets --all-features -- -D warnings'