# nginx reverse proxy for the Jabu Host.
# The Host itself listens on 127.0.0.1:8088 without TLS.

server {
    listen 80;
    server_name jabu.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name jabu.example.org;

    ssl_certificate     /etc/letsencrypt/live/jabu.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jabu.example.org/privkey.pem;

    # Match the Host rate limit or leave the limiter to the Host.
    # limit_req_zone $binary_remote_addr zone=jabu:10m rate=2r/s;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
